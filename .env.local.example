# Copy this file to .env.local and fill in your own values.

# Required — any long random string. Generate one with:
#   openssl rand -base64 32
NEXTAUTH_SECRET=

# The base URL of your app in development.
NEXTAUTH_URL=http://localhost:3000

# Optional — only needed if you want the "Continue with Google" button to
# work. Create credentials at https://console.cloud.google.com/apis/credentials
# and set the redirect URI to:
#   http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — only needed for "Continue with Facebook". Create an app at
# https://developers.facebook.com/apps and set the redirect URI to:
#   http://localhost:3000/api/auth/callback/facebook
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
